# LLM
GEMINI_API_KEY=

# 웹검색 도구
TAVILY_API_KEY=

# 데이터베이스
DATABASE_URL=postgresql+asyncpg://curator:curator@127.0.0.1:5434/curator_db

# 앱 설정
MAX_REACT_ITERATIONS=5
MAX_RETRY_COUNT=2
REQUEST_TIMEOUT_SECONDS=30
MAX_TOKENS_PER_RUN=50000
GEMINI_MODEL=gemini-2.5-flash

# CORS
CORS_ORIGINS=http://localhost:5173
